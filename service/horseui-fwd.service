[Unit]
Description=HorseUI Xuanwu firewall data plane
After=network-online.target
Before=horseui.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/horseui/horseui -fwd -data /etc/horseui -listen 0.0.0.0:8080
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
